{% extends 'base.html.twig' %}
{% block title %}PROFILE · EZStudio_lab{% endblock %}
{% block body %}
<div class="card hero"><div><h1>PROFILE</h1><div class="meta">Phase PROFILE de la chaîne : caractérisation globale du master avant STEMS.</div></div></div>
{% include 'workbench/_song_selector.html.twig' %}

{% if selected_song %}
<div class="card">
<div class="hero">
<div><h2>{{ selected_song.title }}{% if selected_song.artist %} — {{ selected_song.artist }}{% endif %}</h2><div class="meta">PROFILE ne lance jamais STEMS automatiquement.</div></div>
<form method="post" action="{{ path('profile_analyze') }}"><input type="hidden" name="song" value="{{ selected_song.id }}"><button type="submit">Analyser le profil</button></form>
</div>
</div>

{% if profile_runs %}
<div class="card"><form method="get" action="{{ path('workbench_profile') }}" class="row"><input type="hidden" name="song" value="{{ selected_song.id }}"><label>Run PROFILE<select name="run" onchange="this.form.submit()">{% for r in profile_runs %}<option value="{{ r.id }}" {{ selected_profile_run and r.id == selected_profile_run.id ? 'selected' : '' }}>{{ r.public_id }} · {{ r.state }} · {{ r.created_at }}</option>{% endfor %}</select></label></form></div>
{% endif %}

{% if selected_profile_run %}

  {% set job_status = profile_job and profile_job.status is defined ? profile_job.status : selected_profile_run.state %}
  {% set profile_percent = profile_job and profile_job.progress is defined ? profile_job.progress : (selected_profile_run.labels.progress ?? 0) %}
  {% set profile_active = job_status in ['queued','running','cancel_requested'] or selected_profile_run.state in ['queued','running'] %}

  {% if job_status == 'queued' %}
    <div class="card">
      <h2>PROFILE en attente</h2>
      <div class="meta">Job #{{ profile_job.id ?? '—' }} · en attente dans la queue orchestrator · {{ profile_percent }}%</div>
      <progress value="{{ profile_percent }}" max="100" style="width:100%;height:18px">{{ profile_percent }}%</progress>
    </div>
  {% elseif job_status in ['running','cancel_requested'] %}
    <div class="card">
      <h2>Progression PROFILE</h2>
      <div class="meta" style="margin-bottom:5px">Job #{{ profile_job.id ?? '—' }} · {{ job_status }} · {{ profile_percent }}%</div>
      <progress value="{{ profile_percent }}" max="100" style="width:100%;height:18px">{{ profile_percent }}%</progress>
    </div>
  {% elseif job_status in ['failed','cancelled'] or selected_profile_run.state == 'error' %}
    <div class="card">
      <h2>PROFILE en erreur</h2>
      <div class="meta">{{ profile_job.error ?? selected_profile_run.labels.last_error ?? 'Erreur non détaillée.' }}</div>
    </div>
  {% endif %}

{% set p = selected_profile_run.metrics %}
{% set t = selected_profile_run.diagnostics.tagging ?? {} %}
<div class="card"><h2>Caractéristiques</h2><div class="kv">
<div>État</div><div><span class="badge {{ selected_profile_run.state == 'done' ? 'ok' : (selected_profile_run.state == 'error' ? 'warn' : '') }}">{{ selected_profile_run.state }}</span></div>
<div>Tempo</div><div>{% if p.tempo.bpm is defined %}{{ p.tempo.bpm|number_format(2) }} BPM{% else %}—{% endif %}</div>
<div>Signature</div><div>{% if p.time_signature.label is defined and p.time_signature.label %}{{ p.time_signature.label }} · {{ (p.time_signature.confidence * 100)|number_format(0) }}%{% elseif p.time_signature.suggested_label is defined and p.time_signature.suggested_label %}Indéterminée · suggestion {{ p.time_signature.suggested_label }} · {{ (p.time_signature.confidence * 100)|number_format(0) }}%{% else %}Indéterminée{% endif %}</div>
<div>Tonalité</div><div>{% if p.key.label is defined and p.key.label %}{{ p.key.label }} · {{ (p.key.confidence * 100)|number_format(0) }}%{% else %}—{% endif %}</div>
<div>Durée</div><div>{% if p.duration_seconds is defined %}{{ p.duration_seconds|number_format(1) }} s{% else %}—{% endif %}</div>
</div></div>

{% if profile_summary %}
<div class="card profile-summary">
  <h2>Résumé du profil</h2>
  <p style="font-size:14px;line-height:1.55;margin:0 0 12px">{{ profile_summary.text }}</p>
  <div class="summary-grid">
    <div><span>Tempo</span><strong>{% if profile_summary.tempo_bpm is not null %}{{ profile_summary.tempo_bpm|number_format(0) }} BPM · {{ profile_summary.tempo_qualifier }}{% else %}—{% endif %}</strong></div>
    <div><span>Signature</span><strong>{{ profile_summary.meter ?? '—' }}</strong></div>
    <div><span>Tonalité</span><strong>{{ profile_summary.key ?? '—' }}</strong></div>
    <div><span>AudioSet retenu</span><strong>{{ profile_summary.audioset_accepted ? profile_summary.audioset_accepted|join(', ') : '—' }}</strong></div>
  </div>
  {% if profile_summary.genres %}<div class="summary-line"><strong>Genres suggérés</strong> · {% for x in profile_summary.genres %}{{ x.label }} ({{ (x.score*100)|number_format(1) }} %){% if not loop.last %}, {% endif %}{% endfor %}</div>{% endif %}
  {% if profile_summary.moods %}<div class="summary-line"><strong>Ambiances</strong> · {% for x in profile_summary.moods %}{{ x.label }} ({{ (x.score*100)|number_format(1) }} %){% if not loop.last %}, {% endif %}{% endfor %}</div>{% endif %}
  {% if profile_summary.instrumentation %}<div class="summary-line"><strong>Instrumentation probable</strong> · {% for x in profile_summary.instrumentation %}{{ x.label }} ({% if x.score is not null %}{{ (x.score*100)|number_format(1) }} %{% else %}score non calibré{% endif %}){% if not loop.last %}, {% endif %}{% endfor %}</div>{% endif %}
  {% if profile_summary.voice %}<div class="summary-line"><strong>Voix</strong> · {% for x in profile_summary.voice %}{{ x.label }} ({{ (x.score*100)|number_format(1) }} %){% if not loop.last %}, {% endif %}{% endfor %}</div>{% endif %}
  {% if profile_summary.audioset_contextual %}<div class="summary-line"><strong>Autres éléments sonores conservés dans le résultat d’analyse</strong> · {{ profile_summary.audioset_contextual|join(', ') }}</div>{% endif %}
  <div class="meta" style="margin-top:10px">{{ profile_summary.notice }}</div>
</div>
<style>
.profile-summary .summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-bottom:12px}.profile-summary .summary-grid>div{background:#1d2935;color:#ecf3fa;border:1px solid var(--line);border-radius:5px;padding:8px 10px}.profile-summary .summary-grid span{display:block;font-size:10px;color:var(--muted);margin-bottom:3px;text-transform:uppercase;letter-spacing:.05em}.profile-summary .summary-grid strong{font-size:13px;color:#ecf3fa;overflow-wrap:anywhere}.profile-summary p{overflow-wrap:anywhere;white-space:normal}.profile-summary{min-width:0;overflow-wrap:anywhere}.profile-summary .summary-line{font-size:12px;line-height:1.55;padding:4px 0}@media(max-width:900px){.profile-summary .summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
{% endif %}

{# PROFILE_R3D_AI_REVIEW — consultation, aucune promotion de preset #}
{% if selected_profile_run.state == 'done' %}
    <div class="card profile-ai-review">
        {% include 'workbench/profile_ai_button.html.twig' %}
<h2>Révision IA du profil</h2>
        <p class="meta">
            Avis consultatif de l’Assistant, distinct des mesures scientifiques.
            Une inférence terminée ne constitue pas une validation externe.
        </p>
        {% if profile_external_revisions is empty %}
            <p>
                Aucune révision IA enregistrée pour cette analyse.
                La publication de l’Assistant est nécessaire pour afficher ses conclusions.
            </p>
        {% else %}
            {% for revision in profile_external_revisions %}
                {% if loop.index == 2 %}
                    <details class="profile-ai-history">
                        <summary>Historique des révisions ({{ profile_external_revisions|length - 1 }})</summary>
                {% endif %}
                {% set ai = revision.consensus.assistant_ai ?? {} %}
                {% set comparison = revision.comparison.assistant_ai ?? {} %}
                {% set dimensions = comparison.dimensions ?? {} %}
                {% set external = revision.comparison.external_validation ?? {} %}
                <section class="profile-ai-revision">
                    <div class="row">
                        <strong>
                            Révision #{{ revision.id }} ·
                            {{ revision.status == 'completed' ? 'Terminée' : 'Brouillon' }}
                        </strong>
                        <span class="meta">
                            {{ revision.reviewer }} · {{ revision.updated_at }} ·
                            confiance générale {{ (revision.confidence * 100)|number_format(0) }} %
                        </span>
                    </div>
                    <p class="meta">
                        IA : {{ ai.status ?? 'non renseigné' }} ·
                        {{ ai.provider ?? 'inconnu' }} ·
                        {{ ai.model ?? 'modèle non renseigné' }}
                    </p>
                    {% if ai.summary is defined and ai.summary %}
                        <p>{{ ai.summary }}</p>
                    {% endif %}
                    {% if not (external.available ?? false) %}
                        <p class="meta">
                            <strong>Non révisé sur preuves externes :</strong>
                            aucune validation indépendante établie.
                        </p>
                    {% else %}
                        <p class="meta">
                            Comparaison externe indiquée : examiner les références avant validation.
                        </p>
                    {% endif %}
                    {# Musical dimensions, not scientific engine inventory. Technical output is preserved. #}
                    {% set pv_simple = selected_profile_run.diagnostics.profile_view ?? {} %}
                    {% set vocals_simple = pv_simple.vocal_profile.dimensions ?? {} %}
                    {% set musical_advisories = revision.comparison.dimension_advisories.dimensions ?? {} %}
                    {# A decision state is not a musical value: never show possible/inconclusive/unknown as a measurement. #}
                    {% set key_value = pv_simple.tonal.label ?? p.key.label ?? null %}
                    {% set lead_decision = vocals_simple.lead_vocal.decision ?? null %}
                    {% set backing_decision = vocals_simple.backing_vocals.decision ?? null %}
                    {% set harmony_decision = vocals_simple.vocal_harmonies.decision ?? null %}
                    {% set choir_decision = vocals_simple.choir.decision ?? pv_simple.choirs.decision ?? null %}
                    {% set musical_rows = [
                        {'name':'Tempo','value': p.tempo.bpm is defined and p.tempo.bpm is not null ? (p.tempo.bpm|number_format(1) ~ ' BPM') : null,'key':null},
                        {'name':'Mesure','value': p.time_signature.label ?? p.time_signature.suggested_label ?? null,'key':null},
                        {'name':'Tonalité','value': key_value,'key':null},
                        {'name':'Genre musical','value': pv_simple.genre_hierarchy.primary.genre ?? null,'key':'genre'},
                        {'name':'Instrumentation','value': (pv_simple.instrumentation.candidates ?? [])|map(x => x.label)|join(', ') ?: null,'key':'instrumentation'},
                        {'name':'Voix principale','value': lead_decision == 'present' or lead_decision == 'detected' ? 'Voix principale détectée' : (lead_decision == 'absent' ? 'Voix principale non détectée' : null),'key':'lead_vocal'},
                        {'name':'Voix d’accompagnement','value': backing_decision == 'present' or backing_decision == 'detected' ? 'Voix d’accompagnement détectées' : (backing_decision == 'absent' ? 'Voix d’accompagnement non détectées' : null),'key':'backing_vocals'},
                        {'name':'Harmonies vocales','value': harmony_decision == 'present' or harmony_decision == 'detected' ? 'Harmonies vocales détectées' : (harmony_decision == 'absent' ? 'Harmonies vocales non détectées' : null),'key':null},
                        {'name':'Chœurs','value': choir_decision == 'detected' or choir_decision == 'present' ? 'Chœurs détectés' : (choir_decision == 'absent' ? 'Chœurs non détectés' : null),'key':'choir'}
                    ] %}
                    <h3>Résultats musicaux PROFILE</h3>
                    <p class="meta">Uniquement des valeurs musicales identifiables. « — » signifie qu’aucune valeur n’est établie. Les états, scores et diagnostics demeurent dans les JSON privés.</p>
                    <table class="profile-results-simple">
                        <thead><tr><th style="width:23%">Caractéristique</th><th style="width:29%">LAB : valeur</th><th>ASSISTANT : résultat</th></tr></thead>
                        <tbody>
                        {% for musical in musical_rows %}
                            {% set advisory = musical.key ? (attribute(musical_advisories, musical.key) ?? {}) : {} %}
                            <tr>
                                <td><strong>{{ musical.name }}</strong></td>
                                <td>{% if musical.value is not null and musical.value not in ['inconclusive', 'possible', 'unknown', 'not_scored', 'unavailable', 'undetermined'] %}{{ musical.value }}{% else %}<span class="meta">—</span>{% endif %}</td>
                                <td>
                                    {% if musical.key is null %}
                                        <span class="meta">Non évalué séparément par l’Assistant</span>
                                    {% elseif advisory.status ?? '' == 'abstain' %}
                                        <span class="meta">Avis non concluant</span>
                                    {% elseif advisory.advisory ?? '' %}
                                        {{ advisory.advisory }}
                                    {% else %}
                                        <span class="meta">Avis non disponible</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    <details class="profile-ai-technical">
                        <summary>Analyse transversale, validation et diagnostics (détails)</summary>
                    {# Separate consultative musical interpretation from external proof/scoring. #}
                    {% set musical_dimensions = revision.comparison.dimension_advisories.dimensions ?? {} %}
                                        <table>
                        <thead>
                            <tr>
                                <th>Dimension</th>
                                <th>Observation LAB</th><th>Avis Qwen</th><th>Validation externe</th>
                                <th>Confiance IA</th>
                                <th>Indices LAB / références</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for key, label in {
                                'genre': 'Genre',
                                'instrumentation': 'Instrumentation',
                                'lead_vocal': 'Voix principale',
                                'backing_vocals': 'Voix d’accompagnement',
                                'choir': 'Chœurs'
                            } %}
                                {% set item = attribute(dimensions, key) ?? (key == 'lead_vocal' ? (dimensions.lead_vocals ?? {}) : {}) %}
                                <tr>
                                    <td><strong>{{ label }}</strong></td>
                                    <td>{% if key == 'genre' %}{{ selected_profile_run.diagnostics.profile_view.genre_hierarchy.primary.genre ?? '—' }}{% elseif key == 'instrumentation' %}{% for ins in selected_profile_run.diagnostics.profile_view.instrumentation.candidates ?? [] %}{{ ins.label ?? '—' }}{% if not loop.last %}, {% endif %}{% else %}—{% endfor %}{% else %}{{ attribute(selected_profile_run.diagnostics.profile_view.vocal_profile.dimensions ?? {}, key).decision ?? '—' }}{% endif %}</td><td>{% if item.advisory is defined and item.advisory %}
<strong>{{ item.advisory }}</strong>
<div class="meta">Certitude consultative : {{ item.certainty ?? 'indéterminée' }} (non calibrée)</div>
{% if item.recommendation is defined and item.recommendation %}<div class="meta">À examiner : {{ item.recommendation }}</div>{% endif %}
{% elseif item.rationale is defined and item.rationale|trim is not empty %}
{{ item.rationale }}
{% else %}
{% set musical_advice = attribute(musical_dimensions, key) ?? {} %}
{% if musical_advice.advisory ?? '' %}
    <div>{{ musical_advice.advisory }}</div>
    <div class="meta">Incertitude : {{ musical_advice.uncertainty ?? 'non précisée' }}</div>
    <div class="meta">Moteurs consultés : {{ (musical_advice.contributors ?? [])|join(', ') ?: 'aucun' }} · avis non validé</div>
{% else %}
    <span class="meta">Synthèse musicale indisponible pour cette révision. Consulter les modules ci-dessous.</span>
{% endif %}
{% endif %}</td><td>{{ item.decision ?? 'Non évalué' }}{% if item.reason is defined and item.reason|trim is not empty %}<div class="meta">Motif : {{ item.reason }}</div>{% endif %}</td>
                                    <td>
                                        {% if item.confidence is defined and item.confidence is not null %}
                                            {{ (item.confidence * 100)|number_format(0) }} %
                                        {% else %}
                                            Non calibrée
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if item.evidence is defined and item.evidence %}
                                            <details>
                                                <summary>Consulter les indices</summary>
                                                {% if item.evidence is iterable %}
                                                    <ul>
                                                        {% for evidence in item.evidence %}
                                                            <li>
                                                                {% if evidence is iterable %}
                                                                    {{ evidence.label ?? evidence.module ?? 'Indice' }}
                                                                    {% if evidence.module is defined %}
                                                                        · {{ evidence.module }}
                                                                    {% endif %}
                                                                    {% if evidence.score is defined %}
                                                                        · score relatif {{ evidence.score }}
                                                                    {% endif %}
                                                                {% else %}
                                                                    {{ evidence }}
                                                                {% endif %}
                                                            </li>
                                                        {% endfor %}
                                                    </ul>
                                                {% else %}
                                                    {{ item.evidence }}
                                                {% endif %}
                                            </details>
                                        {% else %}
                                            {% if key == 'genre' %}Observation LAB : {{ selected_profile_run.diagnostics.profile_view.genre_hierarchy.primary.genre ?? 'non renseignée' }} ; aucune preuve externe retenue
{% elseif key == 'instrumentation' %}Candidats LAB : {% for ins in selected_profile_run.diagnostics.profile_view.instrumentation.candidates ?? [] %}{{ ins.label ?? '?' }}{% if ins.source_count is defined %} ({{ ins.source_count }} moteurs){% endif %}{% if not loop.last %}, {% endif %}{% else %}aucun{% endfor %} ; aucune preuve externe retenue
{% else %}Observation LAB : {{ attribute(selected_profile_run.diagnostics.profile_view.vocal_profile.dimensions ?? {}, key).decision ?? 'non renseignée' }} ; aucune preuve externe retenue{% endif %}
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% set module_review = revision.comparison.module_consultations ?? {} %}
                    {% set module_results = module_review.results ?? [] %}
                    {% if module_results is not empty %}
                        <details class="profile-ai-modules" {% if loop.first %}open{% endif %}>
                            <summary>Consultations Qwen par module — {{ module_review.examined ?? module_results|length }}/{{ module_review.item_total ?? '?' }} · {{ (module_review.complete ?? false) ? 'couverture complète' : 'couverture partielle' }} · avis non validés</summary>
                            <p class="meta">Les résumés ci-dessous sont des hypothèses IA issues des sorties scientifiques, pas une écoute de l'audio ni une validation documentaire. Les contradictions absentes ne prouvent pas un consensus.</p>
                            <table>
                                <thead><tr><th>Module</th><th>Statut / durée</th><th>Avis Qwen consultatif</th><th>Incertitude et indices</th></tr></thead>
                                <tbody>
                                {% for module in module_results %}
                                    {% set opinion = module.assessment ?? {} %}
                                    <tr>
                                        <td><strong>{{ module.index ?? loop.index }}. {{ module.item_id ?? 'Module inconnu' }}</strong><div class="meta">Source SHA-256 : {{ module.source_sha256 ?? 'non fournie' }}</div></td>
                                        <td>{{ module.status ?? 'inconnu' }}<div class="meta">{{ module.duration_ms ?? '?' }} ms</div></td>
                                        <td>{{ opinion.summary ?? 'Avis non fourni' }}</td>
                                        <td>
                                            <strong>Incertitude :</strong> {{ opinion.uncertainty ?? 'non renseignée' }}
                                            {% if opinion.supporting_evidence ?? [] %}
                                                <details><summary>Indices invoqués ({{ opinion.supporting_evidence|length }})</summary>
                                                    <ul>{% for evidence in opinion.supporting_evidence %}<li>{{ evidence is iterable ? (evidence|json_encode) : evidence }}</li>{% endfor %}</ul>
                                                </details>
                                            {% endif %}
                                            {% if opinion.conflicting_evidence ?? [] %}
                                                <details><summary>Contradictions signalées ({{ opinion.conflicting_evidence|length }})</summary>
                                                    <ul>{% for evidence in opinion.conflicting_evidence %}<li>{{ evidence is iterable ? (evidence|json_encode) : evidence }}</li>{% endfor %}</ul>
                                                </details>
                                            {% else %}<div class="meta">Aucune contradiction signalée par Qwen (non vérifié).</div>{% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </details>
                    {% endif %}
                    </details>
                    {% if revision.sources is empty %}<p class="meta">Références Assistant : aucune URL enregistrée pour cette révision.</p>{% else %}
                        <details>
                            <summary>
                                Sources publiques déclarées ({{ revision.sources|length }})
                            </summary>
                            <ul>
                                {% for source in revision.sources %}
                                    <li>
                                        {{ source.title ?? source.name ?? source.url ?? 'Source sans titre' }} · {{ (source.evidence_accepted ?? false) ? 'preuve externe acceptée' : ((source.identity_relevant ?? false) ? 'source pertinente, sans preuve validée' : 'source consultée, non validée') }}
                                        {% if source.url is defined %}
                                            · <a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">Consulter</a>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </details>
                    {% endif %}
                    <p class="meta">
                        Révision conservée en base · aucune modification de preset.
                    </p>
                </section>
            {% endfor %}
            {% if profile_external_revisions|length > 1 %}
                </details>
            {% endif %}
        {% endif %}
    </div>
    {% if profile_validation_subjects %}
        <details class="card profile-human-optional">
            <summary>
                <strong>Corriger ou commenter (facultatif)</strong>
                · {{ profile_validation_stats.reviewed }} annotation(s) conservée(s)
            </summary>
            <p class="meta">
                Intervention humaine non obligatoire. Les annotations restent indépendantes
                des résultats scientifiques.
            </p>
            <form method="post" action="{{ path('profile_validate', {id: selected_profile_run.id}) }}">
                <table>
                    <thead>
                        <tr>
                            <th>Élément</th>
                            <th>Résultat LAB</th>
                            <th>Observation</th>
                            <th>Correction facultative</th>
                            <th>Commentaire</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for subject in profile_validation_subjects %}
                            {% set saved = profile_validations[subject.subject_key] ?? null %}
                            <tr>
                                <td>
                                    <strong>{{ subject.label }}</strong>
                                    <input
                                        type="hidden"
                                        name="annotations[{{ loop.index0 }}][subject]"
                                        value="{{ subject.subject_key }}"
                                    >
                                </td>
                                <td>{{ subject.predicted_text }}</td>
                                <td>
                                    <select name="annotations[{{ loop.index0 }}][verdict]">
                                        <option value="">Ne pas modifier</option>
                                        <option value="ok">Correct</option>
                                        <option value="ko">Incorrect</option>
                                        <option value="unknown">Incertain</option>
                                    </select>
                                </td>
                                <td>
                                    <input
                                        type="hidden"
                                        name="annotations[{{ loop.index0 }}][reviewer_certainty]"
                                        value="{{ saved ? saved.reviewer_certainty : '' }}"
                                    >
                                    <input
                                        type="hidden"
                                        name="annotations[{{ loop.index0 }}][missing_expected]"
                                        value="{{ saved ? saved.missing_expected_text : '' }}"
                                    >
                                    <input
                                        type="text"
                                        name="annotations[{{ loop.index0 }}][human_value]"
                                        maxlength="500"
                                        value="{{ saved ? saved.human_value : '' }}"
                                        placeholder="Correction"
                                    >
                                </td>
                                <td>
                                    <input
                                        type="text"
                                        name="annotations[{{ loop.index0 }}][comment]"
                                        maxlength="2000"
                                        value="{{ saved ? saved.comment : '' }}"
                                        placeholder="Commentaire facultatif"
                                    >
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <button type="submit">Enregistrer les observations renseignées</button>
            </form>
        </details>
    {% endif %}
{% endif %}

{% set pv = selected_profile_run.diagnostics.profile_view ?? {} %}
{% set pc = pv.counts ?? {} %}
{% set legacy_module_key = 'ped' ~ 'als' %}
{% set modules = pv.modules is defined ? pv.modules : (attribute(pv, legacy_module_key) ?? []) %}
{% set pi = pv.instrumentation ?? {} %}
<div class="card">
  <h2>Instruments détectés</h2>
  <div class="meta">Résultat expérimental sur le mix complet. Il ne pilote pas encore STEMS.</div>
  {% if pi.candidates is defined and pi.candidates %}
    <div style="margin-top:8px">
    {% for x in pi.candidates %}
      <span class="badge ok" style="margin:0 5px 5px 0">{{ x.label }} · {{ x.support }}/3 moteurs</span>
    {% endfor %}
    </div>
  {% else %}
    <p>Aucun instrument n’est suffisamment confirmé pour l’instant.</p>
  {% endif %}
  {% if pi.weak is defined and pi.weak %}
    <details style="margin-top:8px"><summary>Hypothèses plus faibles</summary>
      <div class="meta" style="margin-top:6px">{% for x in pi.weak|slice(0,10) %}{{ x.label }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
    </details>
  {% endif %}
</div>

{% set choir = pv.choirs ?? {} %}
<div class="card">
  <h2>Chœurs / voix d’accompagnement</h2>
  {% if choir.decision is defined and choir.decision == 'detected' %}
    <p><strong>Chœurs détectés</strong></p>
    <div class="meta">Plusieurs analyses vont dans le même sens. À confirmer avec votre écoute.</div>
  {% elseif choir.decision is defined and choir.decision == 'possible' %}
    <p><strong>Chœurs possibles</strong></p>
    <div class="meta">Il y a des indices, mais PROFILE préfère rester prudent.</div>
  {% else %}
    <p><strong>Pas de conclusion fiable</strong></p>
    <div class="meta">PROFILE s’abstient plutôt que d’affirmer qu’il n’y a pas de chœurs.</div>
  {% endif %}
</div>

<div class="card">
  <h2>Gènes PROFILE</h2>
  <div class="meta">{{ pc.ok ?? 0 }} gène(s) OK · {{ pc.skipped ?? 0 }} ignoré(s) · {{ pc.error ?? 0 }} en erreur</div>
  {% if modules %}
  <table><thead><tr><th>Gène</th><th>Famille</th><th>État</th><th>Device</th><th>Temps</th></tr></thead><tbody>
  {% for e in modules %}
    <tr>
      <td>{{ e.name ?? e.id }}{% if e.error %}<div class="meta">{{ e.error }}</div>{% endif %}</td>
      <td>{{ e.family ?? '—' }}</td>
      <td><span class="badge {{ e.status == 'ok' ? 'ok' : (e.status == 'error' ? 'warn' : '') }}">{{ e.status }}</span></td>
      <td>{{ e.device ?? '—' }}</td>
      <td>{% if e.elapsed_seconds is not null %}{{ e.elapsed_seconds|number_format(2) }} s{% else %}—{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody></table>
  {% endif %}
</div>

{% if pv.tonal is defined and pv.tonal.label is defined %}
<div class="card"><h2>Consensus tonal</h2>
  <div><strong>{{ pv.tonal.label }}</strong> · support {{ pv.tonal.support ?? 0 }}/{{ pv.tonal.sources|length }}</div>
  <table><thead><tr><th>Gène</th><th>Tonalité</th><th>Confiance source</th></tr></thead><tbody>
  {% for s in pv.tonal.sources ?? [] %}
    {% set legacy_source_key = 'ped' ~ 'al' %}
    <tr><td>{{ s.module is defined ? s.module : (attribute(s, 'ge' ~ 'ne') ?? '—') }}</td><td>{{ s.label }}</td><td>{% if s.confidence is not null %}{{ (s.confidence*100)|number_format(1) }}%{% else %}—{% endif %}</td></tr>
  {% endfor %}
  </tbody></table>
</div>
{% endif %}

{% if pv.audioset is defined and pv.audioset.agreements is defined %}
<div class="card"><h2>Consensus AudioSet · PANNs / PaSST</h2>
  <div class="meta">Confidence opérationnelle non calibrée : décroissance exponentielle du rang absolu + persistance temporelle top-5/top-10, puis minimum entre PANNs et PaSST. Seuil de décision 60 %. Les labels génériques restent visibles mais ne sont pas retenus. Ce pourcentage n'est pas une probabilité calibrée.</div>
  {% if pv.audioset.agreements %}
  <table><thead><tr><th>Label</th><th>Support</th><th>Scores source</th><th>Confidence</th><th>Stabilité</th><th>Décision</th></tr></thead><tbody>
  {% for a in pv.audioset.agreements %}
    <tr>
      <td>{{ a.label }}</td>
      <td>{{ a.support }}</td>
      <td>{% for s in a.sources ?? [] %}{% set legacy_source_key = 'ped' ~ 'al' %}{{ s.module is defined ? s.module : (attribute(s, 'ge' ~ 'ne') ?? '—') }}={{ (s.score*100)|number_format(1) }}%{% if not loop.last %} · {% endif %}{% endfor %}</td>
      <td>{% if a.confidence is defined and a.confidence is not null %}{{ (a.confidence*100)|number_format(1) }}%{% else %}—{% endif %}</td>
      <td>
        {% if a.source_evidence is defined and a.source_evidence %}
          {% for e in a.source_evidence %}
            {{ e.module is defined ? e.module : (attribute(e, 'ge' ~ 'ne') ?? '—') }} : rang {{ e.rank ?? '—' }}/{{ e.class_count ?? '—' }}, rang-score {% if e.rank_score is defined %}{{ (e.rank_score*100)|number_format(0) }}%{% else %}—{% endif %}, top-5 {% if e.top5_support is defined %}{{ (e.top5_support*100)|number_format(0) }}%{% else %}—{% endif %}, top-10 {{ (e.top10_support*100)|number_format(0) }}%{% if not loop.last %}<br>{% endif %}
          {% endfor %}
        {% elseif a.temporal_support_min is defined and a.temporal_support_min is not null %}
          {{ (a.temporal_support_min*100)|number_format(0) }}%
        {% else %}
          —
        {% endif %}
      </td>
      <td>
        {% if a.decision is defined and a.decision == 'accepted' %}
          <span class="badge ok">retenu</span>
        {% elseif a.decision is defined and a.decision == 'contextual' %}
          <span class="badge">contextuel</span>
        {% elseif a.decision is defined and a.decision == 'generic' %}
          <span class="badge">générique</span>
        {% elseif a.decision is defined %}
          <span class="badge">incertain</span>
        {% else %}
          —
        {% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody></table>
  {% else %}<p class="meta">Aucun label commun entre moteurs.</p>{% endif %}
</div>
{% endif %}

{% if pv.embeddings is defined and pv.embeddings %}
<div class="card"><h2>Embeddings MERT</h2>
<table><thead><tr><th>Gène</th><th>État</th><th>Dimension</th><th>Chunks</th><th>Norme</th><th>Variation temporelle</th></tr></thead><tbody>
{% for e in pv.embeddings %}
<tr><td>{{ e.name }}</td><td>{{ e.status }}</td><td>{{ e.hidden_size ?? '—' }}</td><td>{{ e.chunk_count ?? '—' }}</td><td>{{ e.embedding_norm ?? '—' }}</td><td>{{ e.temporal_std_mean ?? '—' }}</td></tr>
{% endfor %}
</tbody></table>
</div>
{% endif %}

<div class="card"><div class="meta">Moteur sémantique : {{ t.backend ?? 'indisponible' }}{% if t.model is defined %} · {{ t.model }}{% endif %}. Les scores CLAP sont relatifs à la taxonomie comparée, pas des probabilités calibrées.</div></div>
<div class="card"><h2>Genre</h2>{% if t.available ?? false %}<table><thead><tr><th>Tag</th><th>Score</th></tr></thead><tbody>{% for x in t.genre ?? [] %}<tr><td>{{ x.label }}</td><td>{{ (x.score*100)|number_format(1) }}%</td></tr>{% endfor %}</tbody></table>{% else %}<p class="meta">Analyse du genre indisponible.</p>{% endif %}</div>
<div class="card"><h2>Instrumentation probable</h2>{% if t.available ?? false %}<table><thead><tr><th>Instrument</th><th>Score</th></tr></thead><tbody>{% for x in t.instrumentation ?? [] %}<tr><td>{{ x.label }}</td><td>{{ (x.score*100)|number_format(1) }}%</td></tr>{% endfor %}</tbody></table>{% else %}<p class="meta">Classifieur instrument non disponible.</p>{% endif %}</div>
<div class="card"><h2>Voix</h2>{% if t.available ?? false %}<table><thead><tr><th>Caractéristique</th><th>Score</th></tr></thead><tbody>{% for x in t.voice ?? [] %}<tr><td>{{ x.label }}</td><td>{{ (x.score*100)|number_format(1) }}%</td></tr>{% endfor %}</tbody></table>{% else %}<p class="meta">Classifieur vocal non disponible.</p>{% endif %}</div>
<div class="card"><h2>Ambiance / mood</h2>{% if t.available ?? false %}<table><thead><tr><th>Tag</th><th>Score</th></tr></thead><tbody>{% for x in t.mood ?? [] %}<tr><td>{{ x.label }}</td><td>{{ (x.score*100)|number_format(1) }}%</td></tr>{% endfor %}</tbody></table>{% else %}<p class="meta">Classifieur mood non disponible.</p>{% endif %}</div>
<div class="card"><a class="button secondary" href="{{ path('scientific_run',{id:selected_profile_run.id}) }}">Run PROFILE</a> <a class="button" href="{{ path('workbench_stems',{song:selected_song.id}) }}">Ouvrir STEMS</a> <span class="meta">Navigation uniquement.</span></div>
{% if profile_active %}
<div data-profile-live-refresh="1" hidden></div>
<script>
(() => {
  const marker = document.querySelector('[data-profile-live-refresh="1"]');
  if (!marker || window.__ezstudioProfileLiveRefresh) return;
  window.__ezstudioProfileLiveRefresh = true;

  let stopped = false;

  async function refreshProfileContent() {
    if (stopped) return;

    try {
      const response = await fetch(window.location.href, {
        cache: 'no-store',
        headers: {'Accept': 'text/html'}
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      const html = await response.text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const nextWrap = doc.querySelector('.wrap');
      const currentWrap = document.querySelector('.wrap');

      if (!nextWrap || !currentWrap) {
        throw new Error('profile_wrap_missing');
      }

      const stillActive = !!nextWrap.querySelector('[data-profile-live-refresh="1"]');
      currentWrap.innerHTML = nextWrap.innerHTML;

      if (stillActive) {
        window.setTimeout(refreshProfileContent, 2500);
      } else {
        stopped = true;
        window.__ezstudioProfileLiveRefresh = false;
      }
    } catch (error) {
      window.setTimeout(refreshProfileContent, 2500);
    }
  }

  window.addEventListener('pagehide', () => { stopped = true; }, {once:true});
  window.setTimeout(refreshProfileContent, 2500);
})();
</script>
{% endif %}
{% endif %}
{% endif %}
{% endblock %}
