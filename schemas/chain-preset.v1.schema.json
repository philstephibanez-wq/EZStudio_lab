{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ezstudio.chain-preset.v1",
  "title": "EZStudio ChainPreset",
  "type": "object",
  "required": [
    "schema",
    "id",
    "revision",
    "phases"
  ],
  "properties": {
    "schema": {
      "const": "ezstudio.chain-preset.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "runtime_min": {
      "type": [
        "string",
        "null"
      ]
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "phase",
          "preset"
        ],
        "properties": {
          "phase": {
            "enum": [
              "profile",
              "stems",
              "chords",
              "lyrics"
            ]
          },
          "preset": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "publication_gates": {
      "type": "object"
    }
  }
}